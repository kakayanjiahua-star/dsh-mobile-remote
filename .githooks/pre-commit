#!/bin/sh
# ---------------------------------------------------------------------------
# dsh-mobile-remote pre-commit privacy guard
# Blocks commits that would publish secrets or personal data.
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass deliberately:     git commit --no-verify
# ---------------------------------------------------------------------------
set -u
fail=0

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

check() {
  pattern="$1"; label="$2"; allow="${3:-}"
  for f in $files; do
    case "$f" in .githooks/*) continue ;; esac
    content=$(git show ":$f" 2>/dev/null | tr -d '\r') || continue
    [ -z "$content" ] && continue
    hits=$(printf '%s\n' "$content" | grep -anE "$pattern" || true)
    if [ -n "$allow" ]; then hits=$(printf '%s\n' "$hits" | grep -avE "$allow" || true); fi
    if [ -n "$hits" ]; then
      printf '\n[BLOCKED] %s  (file: %s)\n' "$label" "$f"
      printf '%s\n' "$hits" | head -n 3 | sed 's/^/    /'
      fail=1
    fi
  done
}

# --- secrets / tokens -------------------------------------------------------
check '"barkKey"[[:space:]]*:[[:space:]]*"[A-Za-z0-9_-]{10,}"' 'real Bark key in config'
check '"ntfyTopic"[[:space:]]*:[[:space:]]*"[A-Za-z0-9_-]{6,}"'   'real ntfy topic in config'
check '(gh[pousr]_[A-Za-z0-9]{20,})'                              'GitHub token'
check '(sk-[A-Za-z0-9]{20,})'                                     'API key (sk-...)'
check '\b[0-9a-f]{64}\b'                                          '64-hex secret-looking string'

# --- personal data ----------------------------------------------------------
check 'https://[a-z0-9-]{4,}\.trycloudflare\.com' 'live tunnel URL' 'xxx\.trycloudflare\.com'
check '(100\.(6[4-9]|[7-9][0-9]|1[0-2][0-7])\.[0-9]{1,3}\.[0-9]{1,3})' 'Tailscale (100.64/10) address' '100\.64\.0\.0'
check '(192\.168\.[0-9]{1,3}\.[0-9]{1,3})'        'LAN 192.168.x.x address'
check '(10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})'  'LAN 10.x.x.x address'
check '(172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})' 'LAN 172.16-31.x.x address'
check '[A-Za-z]:\\+Users\\+[A-Za-z0-9._-]+'       'personal Windows user path'
check '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' 'email address' 'noreply\.github\.com'
check 'kakayanjiahua[^-]'                          'personal account name' 'kakayanjiahua-star'

if [ "$fail" -ne 0 ]; then
  printf '\nCommit rejected: remove the personal data above, or commit with --no-verify (not recommended).\n\n'
  exit 1
fi
exit 0